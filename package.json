{
  "name": "extrahand-quick-commerce-backend",
  "version": "1.0.0",
  "description": "ExtraHand Quick Commerce API service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:catalogue": "ts-node src/scripts/seedCatalogue.ts",
    "seed:master": "ts-node src/scripts/seedMasterCatalogue.ts",
    "seed:products": "ts-node src/scripts/seedMasterProducts.ts",
    "seed:all": "ts-node src/scripts/seed.ts && ts-node src/scripts/seedCatalogue.ts && ts-node src/scripts/seedMasterCatalogue.ts && ts-node src/scripts/seedMasterProducts.ts"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
